# =====================================================================
# Job Market Skill Demand Analyzer - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' to configure live API data ingestion.
# (Optional: the app runs fully in Demo and File Upload mode without keys).

# 1. Techmap Job Posting API (https://techmap.io)
# Free tier offers ~1,000 job postings/month with pre-tagged skills.
TECHMAP_API_KEY=YOUR_TECHMAP_API_KEY_HERE

# 2. JSearch API on RapidAPI (https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch)
# Free tier offers ~200 requests/month (aggregates Google for Jobs, Indeed, LinkedIn, etc.)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE
